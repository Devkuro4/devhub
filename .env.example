# Copy to .env for local use.
# Never commit your real .env file.

# --- Server only (secret). Set at least ONE AI key. ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: Gemini instead of / as well as Groq (Gemini is used first when both are set).
# GEMINI_API_KEY=


# --- Supabase (Project Settings > API). These two are baked into the site at build time. ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Only if the website and the server are hosted separately ---
# VITE_API_URL=https://your-server.onrender.com
# ALLOWED_ORIGINS=https://your-site.vercel.app

# --- Leave unset for a real launch. Only for deliberately publishing a demo. ---
# VITE_ALLOW_DEMO=true
# ALLOW_DEMO=true

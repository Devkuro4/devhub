# ---------------------------------------------------------------------------
# Dev Hub environment variables. Copy to .env for local use (never commit .env).
# On Render, set these in the dashboard (Environment tab) instead.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY (REQUIRED): your Google Gemini API key. Create one at https://aistudio.google.com/apikey
# Server only: never prefix it with VITE_, and never put it in frontend code.
GEMINI_API_KEY=""

# GEMINI_MODEL (optional): which Gemini model powers every AI feature. Default: gemini-3.8-flash
# The admin console can also switch models at runtime (until the server restarts).
# GEMINI_MODEL="gemini-3.8-flash"

# GEMINI_TIMEOUT_MS (optional): give up on a single Gemini attempt after this long. Default 45000 (1000-120000).
# GEMINI_TIMEOUT_MS=45000

# GEMINI_MAX_RETRIES (optional): extra attempts after a rate limit, timeout or 5xx. Default 2 (0-4).
# GEMINI_MAX_RETRIES=2

# GEMINI_FALLBACK_MODEL (optional): lighter model tried automatically when the main model hits its rate limit
# or quota. Default gemini-3.5-flash-lite. Set to "off" to disable.
# GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# GEMINI_MAX_RPM (optional): most requests per minute this server will send to Gemini. Default 8, which suits
# free-tier keys. Raise it on a paid key; 0 turns the limiter off.
# GEMINI_MAX_RPM=8

# Supabase (accounts and database). Use the anon / publishable key, never the service_role key.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Only when the website and this server are hosted separately (e.g. site on Vercel, server on Render):
# ALLOWED_ORIGINS="https://yourhub.vercel.app"
# VITE_API_URL="https://your-server.onrender.com"

# APP_URL: where this app is hosted (used for self-referential links).
APP_URL="MY_APP_URL"

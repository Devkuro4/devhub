# ---------------------------------------------------------------------------
# Dev Hub environment variables. Copy to .env for local use (never commit .env).
# On Render, set these in the dashboard (Environment tab) instead.
# ---------------------------------------------------------------------------

# GROQ_API_KEY (REQUIRED): your Groq API key. Create one free at https://console.groq.com/keys (no card needed).
# Server only: never prefix it with VITE_, and never put it in frontend code.
GROQ_API_KEY=""

# GROQ_MODEL (optional): which Groq model powers every AI feature. Default: openai/gpt-oss-120b
# The admin console can also switch models at runtime (until the server restarts).
# Model ids: https://console.groq.com/docs/models
# GROQ_MODEL="openai/gpt-oss-120b"

# GROQ_TIMEOUT_MS (optional): give up on a single Groq attempt after this long. Default 45000 (1000-120000).
# GROQ_TIMEOUT_MS=45000

# GROQ_MAX_RETRIES (optional): extra attempts after a rate limit, timeout or 5xx. Default 2 (0-4).
# GROQ_MAX_RETRIES=2

# GROQ_FALLBACK_MODEL (optional): lighter model tried automatically when the main model hits its rate limit
# or quota (each model has its own free limits). Default openai/gpt-oss-20b. Set to "off" to disable.
# GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"

# GROQ_MAX_RPM (optional): most requests per minute this server will send to Groq. Default 20, which suits
# the free tier. Raise it on a paid key; 0 turns the limiter off.
# GROQ_MAX_RPM=20

# GROQ_MAX_OUTPUT_TOKENS (optional): cap on tokens requested per answer. Default 6000. Free-tier per-minute token
# limits count the size you ask for, so keep this modest; raise it only if long answers get cut off.
# GROQ_MAX_OUTPUT_TOKENS=6000

# Supabase accounts and browser data use the anon / publishable key.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Canonical public member-site URL. Supabase confirmation and magic links return here.
# Set this to the domain teammates should see, not an old Vercel preview URL. No trailing path is needed.
# VITE_PUBLIC_SITE_URL="https://devhub.yourdomain.com"

# Server only. Required for durable competitions, messages, moderation and learning state on hosted deployments.
# Find it in Supabase > Project Settings > API. Never prefix this value with VITE_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Only when the website and this server are hosted separately (e.g. site on Vercel, server on Render):
# ALLOWED_ORIGINS="https://yourhub.vercel.app"
# VITE_API_URL="https://your-server.onrender.com"

# APP_URL: server-side canonical URL. Keep it aligned with VITE_PUBLIC_SITE_URL on a combined deployment.
APP_URL="MY_APP_URL"
